# Copy to .env and fill in. Never commit .env.

# Your bot's token (discord.com/developers → your app → Bot → Reset Token).
DISCORD_TOKEN=

# Your license key, from your purchase email or the store's download page.
LICENSE_KEY=

# How often the license is re-checked while the bot runs, in hours (0 = only at start-up).
RECHECK_HOURS=6

# Anonymous usage statistics for the bot's developer (versions, OS, Node.js; no names or IP addresses).
# Set to false to turn them off. They never affect the license check.
ANALYTICS=true
